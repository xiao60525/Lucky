.intro {
    background: linear-gradient(135deg, #5a5cf0 0%, #8b5cf6 100%);
    color: #ffffff;
}

.intro-title {
    font-size: 36rpx;
    font-weight: 600;
}

.intro-desc {
    margin-top: 10rpx;
    font-size: 26rpx;
    line-height: 1.6;
    opacity: 0.92;
}

.intro-version {
    margin-top: 18rpx;
    font-size: 22rpx;
    opacity: 0.75;
}

.faq {
    padding-top: 8rpx;
    padding-bottom: 8rpx;
}

.faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 0;
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.faq-arrow {
    font-size: 34rpx;
    color: #b6bbc6;
    transition: transform 0.15s ease;
}

.faq-arrow.is-open {
    transform: rotate(90deg);
}

.faq-a {
    padding: 0 0 22rpx;
    font-size: 26rpx;
    color: #5a6070;
    line-height: 1.75;
}

.links {
    padding-top: 4rpx;
    padding-bottom: 4rpx;
}

.link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26rpx 0;
    font-size: 28rpx;
    color: #1f2329;
    border-bottom: 1rpx solid #f0f2f6;
}

.link:last-child {
    border-bottom: 0;
}

.link-arrow {
    font-size: 32rpx;
    color: #b6bbc6;
}
