<view class="page">
  <view wx:if="{{state === 'loading'}}" class="state">
    <view class="state-desc">正在创建订单…</view>
  </view>

  <block wx:elif="{{state === 'need-login'}}">
    <view class="state">
      <view class="state-title">下单需要先登录</view>
      <view class="state-desc">去「我的」用手机号验证码登录一下，回来就能下单了</view>
    </view>
    <view class="btn-primary" bindtap="onGoLogin">去登录</view>
  </block>

  <block wx:elif="{{state === 'error'}}">
    <view class="error-box">{{error}}</view>
    <view class="btn-ghost" bindtap="onRetry">重试</view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="pay-title">{{product.title}}</view>
      <view class="pay-amount"><text class="price-symbol">¥</text>{{product.amountText}}</view>
      <view class="divider"></view>
      <view class="pay-row">
        <text class="muted">订单号</text>
        <text class="pay-value">{{order.id}}</text>
      </view>
      <view class="pay-row">
        <text class="muted">状态</text>
        <text class="pay-status">{{order.statusText}}</text>
      </view>
      <view class="pay-row">
        <text class="muted">下单时间</text>
        <text class="pay-value">{{order.createdText}}</text>
      </view>
    </view>

    <view class="card tip-card">
      <view class="tip-title">支付功能开发中</view>
      <view class="tip-desc">订单已经存进你的账户，等支付接入后可以直接在这里完成付款，不用重新下单。</view>
    </view>

    <view class="btn-primary" bindtap="onBack">返回继续逛</view>
  </block>
</view>
