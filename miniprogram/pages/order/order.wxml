<view class="page order-page">
  <view wx:if="{{state === 'loading'}}" class="state">
    <view class="state-desc">正在读取订单…</view>
  </view>

  <block wx:elif="{{state === 'error'}}">
    <view class="error-box">{{error}}</view>
    <view class="btn-ghost" bindtap="onRetry">重新加载</view>
  </block>

  <block wx:else>
    <view class="status-card status-{{order.status}}">
      <view class="status-title">{{order.statusText}}</view>
      <view class="status-hint">{{hint}}</view>
      <view class="status-new" wx:if="{{isNew && order.status === 'created'}}">下单成功，记得完成支付</view>
    </view>

    <view class="card goods">
      <view class="goods-cover">{{order.initial}}</view>
      <view class="goods-info">
        <view class="goods-title">{{order.title}}</view>
        <view class="goods-meta muted">¥{{order.unitText}} × {{order.qty}}</view>
      </view>
      <view class="goods-amount"><text class="price-symbol">¥</text>{{order.amountText}}</view>
    </view>

    <view class="card info">
      <view class="info-row">
        <text class="info-label">订单号</text>
        <view class="info-value-row">
          <text class="info-value info-mono">{{order.id}}</text>
          <text class="copy-btn" bindtap="onCopyId">复制</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createdText}}</text>
      </view>
      <view class="info-row" wx:if="{{order.paidText}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{order.paidText}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>

    <view class="card tip-card" wx:if="{{order.status === 'created'}}">
      <view class="tip-title">关于支付</view>
      <view class="tip-desc">微信支付需要先把小程序绑定并开通（权限集 157）。在那之前，可以用下面的「演示支付」把订单状态走完，方便先体验完整流程，不会扣任何钱。</view>
    </view>

    <view class="actions">
      <block wx:if="{{order.status === 'created'}}">
        <view class="btn-primary {{acting ? 'is-loading' : ''}}" bindtap="onPay">演示支付</view>
        <view class="btn-ghost action-gap" bindtap="onCancel">取消订单</view>
      </block>
      <block wx:elif="{{order.status === 'paid'}}">
        <view class="btn-primary" bindtap="onBuyAgain">再来一单</view>
        <view class="btn-ghost action-gap" bindtap="onGoShop">继续逛逛</view>
      </block>
      <block wx:else>
        <view class="btn-primary" bindtap="onBuyAgain">重新下单</view>
        <view class="btn-ghost action-gap" bindtap="onGoOrders">返回我的订单</view>
      </block>
    </view>
  </block>
</view>
