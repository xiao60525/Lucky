{
  "appId": "host.workbuddy.xiaogua",
  "appName": "手机App支付骨架",
  "webDir": "www",
  "bundledWebRuntime": false,
  "ios": {
    "contentInset": "always",
    "scheme": "App",
    "backgroundColor": "#f4f5f9",
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
