# ---------------------------------------------------------------
# 微信支付配置（复制本文件为 .env 再填写；.env 不要提交到代码仓库）
# 商户号 1119507394 已在下面填好，其余需要你从商户平台取
# ---------------------------------------------------------------

WX_MCHID=1119507394

# 小程序 / 公众号 / APP 的 AppID（必须与该商户号完成绑定，否则下单会报 PARAM_ERROR）
WX_APPID=

# 商户平台 > 账户中心 > API安全 > APIv3密钥（自己设置的 32 位字符串）
WX_API_V3_KEY=

# 商户平台 > 账户中心 > API安全 > API证书：证书序列号 + 下载的私钥路径
WX_SERIAL_NO=
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_CERT_PATH=./certs/apiclient_cert.pem

# 支付结果回调地址：必须是公网可访问的 https 地址，指向本服务的 /api/notify/wechat
WX_NOTIFY_URL=

# 下单方式：auto（按 UA 自动适配，推荐）| native（扫码）| jsapi（微信内/小程序）| h5（手机浏览器，需开通H5支付）
# auto 规则：微信内置浏览器 -> JSAPI；手机浏览器 -> H5；电脑 -> 扫码
WX_PAY_SCENE=auto

# jsapi 模式下的测试用 openid（正式环境应从登录态里取用户 openid，不要写死）
WX_TEST_OPENID=

# 微信支付公钥模式（新版商户号推荐）：公钥文件路径 + 公钥ID
# 若使用平台证书模式，这两项留空，程序会自动下载平台证书验签
WX_PLATFORM_PUBLIC_KEY_PATH=
WX_PLATFORM_PUBLIC_KEY_ID=

# 模拟渠道的签名密钥（仅在 PAY_PROVIDER=mock 时使用）
PAY_SECRET=demo-pay-secret-change-me

# 管理后台登录密码（访问 /admin）
ADMIN_PASSWORD=
# 未支付订单保留时长（分钟，默认 30）：超时未支付订单会被服务端自动删除
ORDER_TTL_MINUTES=30
# 预览部署才需要：网关会剥掉 URL 里的 sharecode，填上后 PWA「添加到主屏幕」才能正常启动
PUBLIC_SHARECODE=

# ---------------- 云服务（WorkBuddy Cloud Service · Database） ----------------
# 下面三项来自 cloud_service activate 返回的 publicConfig，属于公开配置
CLOUD_ENDPOINT=
CLOUD_PUBLISHABLE_KEY=
CLOUD_OAUTH_RELAY=
# 服务端专用密钥：只保存在服务端，浏览器拿不到；缺失时订单写不进云库
CLOUD_DB_SECRET=

# ---------------- 小程序云库（可选：后台查看小程序用户手机号） ----------------
# 小程序是独立应用、独立云环境，与上面的网页版库不相通；不填则后台「用户」页显示未配置
MP_CLOUD_ENDPOINT=
MP_CLOUD_PUBLISHABLE_KEY=
# 只读密钥：仅能调用 app_admin_list_users，无法写入任何数据
MP_CLOUD_SECRET=

# ---------------- 应用外观（可选） ----------------
# 程序名称与图标推荐直接在管理后台「外观」页设置（存云库，重启不丢）；
# 下面这项只是云库尚未写入时的兜底名称
APP_NAME=

# ---------------- 支付宝（真实收款） ----------------
# 在 https://open.alipay.com 创建应用（网页/移动应用）并签约「手机网站支付」「电脑网站支付」后获得。
# 密钥用 node scripts/alipay-keys.js 生成：应用公钥填到开放平台，支付宝公钥复制回来填这里。
# 电脑网站支付（page.pay）签约后再设为 1；未签约保持 0，统一走手机网站支付
ALIPAY_PAGE_PAY=0
ALIPAY_APP_ID=
# 应用私钥（PKCS8 PEM，整段贴进来，或写文件路径到 ALIPAY_PRIVATE_KEY_PATH）
# ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ALIPAY_PRIVATE_KEY_PATH=certs/alipay_app_private_key.pem
# 支付宝公钥（注意：不是「应用公钥」）
ALIPAY_PUBLIC_KEY_PATH=
# 异步通知地址（公网 https）
ALIPAY_NOTIFY_URL=
# 同步跳回地址
ALIPAY_RETURN_URL=
# 沙箱环境设为 1 则走 openapi.alipaydev.com
ALIPAY_SANDBOX=0
